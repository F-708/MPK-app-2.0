<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила резервного копирования (API 30 и ниже).

   Файл активации mpk_activation.xml намеренно исключён: иначе после
   переустановки Android восстановил бы флаг активации из облачной копии,
   и приложение открылось бы без кода. Остальные настройки и задания
   резервируются как обычно.

   См. https://developer.android.com/guide/topics/data/autobackup
   Внимание: этот файл не используется на устройствах новее API 31 —
   там работает data_extraction_rules.xml
-->
<full-backup-content>
    <exclude domain="sharedpref" path="mpk_activation.xml"/>
</full-backup-content>
