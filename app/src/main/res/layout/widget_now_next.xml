<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Сейчас и дальше».
     Два блока делят высоту поровну (0dp + weight), поэтому пустого места
     внизу не остаётся — при любом размере виджета он заполнен целиком. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/now_next_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFFFF"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Блок «сейчас» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_now_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="СЕЙЧАС"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_now_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- N7: строка «время + кабинет». Время занимает всю ширину (weight=1),
                 чип кабинета вытесняется в правый конец строки — не поверх текста
                 «СЕЙЧАС/ДАЛЬШЕ» и не заезжает на разделитель. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_now_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#0B3564"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Б7/N7: кабинет — отдельная кнопка-чип, на неё вешается свой
                     PendingIntent (карта с этим кабинетом). Цвет фона и текста ставится
                     из кода по стилю виджета (highlightColor/mainColor) — контраст во
                     всех 4 темах. При showRoom=false или пустом кабинете прячется (gone). -->
                <TextView
                    android:id="@+id/tv_now_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_widget_room_chip"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0B3564"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <!-- Блок «дальше» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ДАЛЬШЕ"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- N7: строка «время + кабинет» — чип справа, как в блоке «сейчас» -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_next_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#0B3564"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_next_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_widget_room_chip"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0B3564"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    </FrameLayout>
