                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:text="308"
                android:textColor="@color/widget_accent_green"
                android:textSize="10sp"
                android:textStyle="bold" />
