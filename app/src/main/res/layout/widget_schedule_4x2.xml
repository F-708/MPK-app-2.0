<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Шапка виджета -->
    <LinearLayout
        android:id="@+id/layout_schedule_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_schedule_group_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_group_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="41О"
            android:textColor="@color/widget_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_schedule_day_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Сегодня • Вторник"
            android:textColor="@color/widget_text_title"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Кнопка переключения дня -->
        <LinearLayout
            android:id="@+id/btn_schedule_toggle_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_group_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_swap"
                android:contentDescription="Сменить день" />

            <TextView
                android:id="@+id/tv_schedule_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Завтра"
                android:textColor="@color/widget_primary_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Список пар (Слот 1..6) -->
    <LinearLayout
        android:id="@+id/layout_schedule_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Ряд 1 -->
        <LinearLayout
            android:id="@+id/row_lesson_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_row1_num"
                android:layout_width="18dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/widget_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_row1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="08:15"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_row1_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Инф. технол."
                android:textColor="@color/widget_text_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Подгруппа 1 микро-бейдж -->
            <TextView
                android:id="@+id/tv_row1_subgroup1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_widget_subgroup_1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Подгруппа 2 микро-бейдж -->
            <TextView
                android:id="@+id/tv_row1_subgroup2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_widget_subgroup_2"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_row1_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_widget_room_badge"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:text="314"
                android:textColor="@color/widget_accent_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ряд 2 -->
