                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_row2_subgroup1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_widget_subgroup_1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_row2_subgroup2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_widget_subgroup_2"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/white"
