<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Верхняя панель: Группа и Статус/Таймер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_live_group_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_group_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="41О"
            android:textColor="@color/widget_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:singleLine="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_live_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_countdown_pill"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="До конца: 25 мин"
            android:textColor="@color/widget_accent_orange"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Основной блок текущего/следующего урока -->
    <LinearLayout
        android:id="@+id/layout_live_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_live_acronym"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_acronym_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="ТОЭ"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_live_subject_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Теоретические основы электротехники"
                android:textColor="@color/widget_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_live_time_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="1 пара • 08:15 – 09:55"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_live_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_room_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="каб. 314"
                android:textColor="@color/widget_accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_live_teacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Иванов И.И."
                android:textColor="@color/widget_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Заглушка при отсутствии занятий / пустом расписании -->
    <LinearLayout
        android:id="@+id/layout_live_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_school"
            android:contentDescription="Колледж" />

        <TextView
            android:id="@+id/tv_live_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="На сегодня занятий нет"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
