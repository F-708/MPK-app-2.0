<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Служба минутного отсчёта «До звонка» (работает только при включённой строке) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Виджет «До звонка» (2x1, настраиваемый цвет фона) -->
        <receiver
            android:name=".widget.BellCountdownWidgetProvider"
            android:exported="true"
            android:label="До звонка">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bell_countdown_widget_info" />
        </receiver>

        <!-- Виджет «Сейчас / дальше» (3x2): что идёт сейчас и что будет следующим -->
        <receiver
            android:name=".widget.NowNextWidgetProvider"
            android:exported="true"
            android:label="Сейчас и дальше">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_next_widget_info" />
        </receiver>

        <!-- Виджет «Расписание на сегодня» (4x4): весь день списком -->
        <receiver
            android:name=".widget.TodayScheduleWidgetProvider"
            android:exported="true"
            android:label="Расписание на сегодня">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_schedule_widget_info" />
        </receiver>

        <!-- Виджет «Звонки» (2x4): расписание звонков с подсветкой текущего -->
        <receiver
            android:name=".widget.BellsWidgetProvider"
            android:exported="true"
            android:label="Звонки">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bells_widget_info" />
        </receiver>

        <!-- Настройка виджета при добавлении -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Служба минутного отсчёта «До звонка» и обновления виджета -->
        <service
            android:name=".util.BellTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Постоянный обратный отсчёт до звонка в строке уведомлений" />
        </service>

        <!-- Минутный тик виджета + перезапуск будильника после перезагрузки -->
        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.widget.ACTION_BELL_COUNTDOWN_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
