<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay-манифест flavor'а teacher: регистрация teacher-виджетов ТОЛЬКО здесь.
     В main-манифест НЕ добавляем — иначе виджеты появятся у студентов.
     Manifest merger (AGP) подхватывает src/teacher/AndroidManifest.xml и сливает
     эти <receiver> в итоговый манифест teacher-сборки. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- T4-B: лёгкий точный будильник напоминания о паре (SPEC §5.3 «за N мин до пары»).
             Свой receiver, НЕ WidgetAlarmReceiver — виджетов у преподавателя может не быть.
             Только в teacher-сборке: в студенческой профиль null, будильник не взводится. -->
        <receiver
            android:name="com.politex.util.TeacherReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.politex.util.ACTION_TEACHER_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Виджет преподавателя «Следующая пара» (4×1 / 2×2) -->
        <receiver
            android:name="com.politex.widget.TeacherNextWidgetProvider"
            android:exported="true"
            android:label="Следующая пара">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_teacher_next_info" />
        </receiver>

        <!-- Виджет преподавателя «Моё сегодня» (4×2) -->
        <receiver
            android:name="com.politex.widget.TeacherTodayWidgetProvider"
            android:exported="true"
            android:label="Моё сегодня">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_teacher_today_info" />
        </receiver>
        <!-- Релиз-ревью №3: студенческие виджеты в teacher-сборке — мёртвые (профиль группы
             не выбран) и крашат тапом EXTRA_ROOM. Вырезаются merger'ом. WidgetAlarmReceiver
             и BOOT остаются: минутный тик обновляет teacher-виджеты (hasWork их учитывает). -->
        <receiver android:name="com.politex.widget.BellCountdownWidgetProvider" tools:node="remove" />
        <receiver android:name="com.politex.widget.NowNextWidgetProvider" tools:node="remove" />
        <receiver android:name="com.politex.widget.TodayScheduleWidgetProvider" tools:node="remove" />
        <receiver android:name="com.politex.widget.BellsWidgetProvider" tools:node="remove" />
        <activity android:name="com.politex.widget.WidgetConfigActivity" tools:node="remove" />
    </application>
</manifest>
